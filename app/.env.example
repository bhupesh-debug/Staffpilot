# StaffPilot — copy to .env.local and fill in your own values.
# NEVER commit a real .env.local. All values below are placeholders.

# --- Supabase (required for auth + database) ---
# Create a free project at https://supabase.com/dashboard, then copy from
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service-role key is ONLY for server-side scripts / seed jobs. Never expose
# it to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to sign/verify internal tokens if added later. Generate with:
#   openssl rand -hex 32
APP_SECRET=change-me-to-a-random-32-byte-hex-string

# --- Integrations (NOT CONNECTED — see docs/ARCHITECTURE.md) ---
# Leave these unset until an integration is deliberately configured.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# PAYROLL_PROVIDER_API_KEY=
# PAYMENT_PROCESSOR_API_KEY=
